<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="panelServicios" prefHeight="580.0" prefWidth="1000.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.parcial2.viewController.viewControllerServicios">
   <children>
      <AnchorPane layoutX="0.0" layoutY="0.0" prefHeight="38.0" prefWidth="1000.0" style="-fx-background-color: #1E3A5F;">
         <children>
            <Label layoutX="16.0" layoutY="10.0" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" text="TechSolutions" />
         </children>
      </AnchorPane>
      <AnchorPane layoutX="0.0" layoutY="38.0" prefHeight="38.0" prefWidth="1000.0" style="-fx-background-color: #DDE3EA;">
         <children>
            <Button fx:id="btnVolverInicio" layoutX="14.0" layoutY="6.0" mnemonicParsing="false" onAction="#onVolverClick" style="-fx-background-color: #44505E; -fx-text-fill: white; -fx-background-radius: 4;" text="&lt;- Inicio" />
            <Label layoutX="110.0" layoutY="9.0" style="-fx-text-fill: #1E3A5F; -fx-font-size: 15px; -fx-font-weight: bold;" text="Servicios" />
         </children>
      </AnchorPane>
      <Label layoutX="14.0" layoutY="88.0" style="-fx-text-fill: #1E3A5F; -fx-font-weight: bold;" text="Catálogo de servicios" />
      <TableView fx:id="tblServicios" layoutX="14.0" layoutY="108.0" prefHeight="215.0" prefWidth="560.0">
        <columns>
          <TableColumn fx:id="colCodigo" prefWidth="70.0" text="Código" />
          <TableColumn fx:id="colNombre" prefWidth="170.0" text="Nombre" />
          <TableColumn fx:id="colDescripcion" prefWidth="210.0" text="Descripción" />
          <TableColumn fx:id="colCostoBase" prefWidth="100.0" text="Costo base" />
        </columns>
      </TableView>
      <AnchorPane layoutX="14.0" layoutY="335.0" prefHeight="200.0" prefWidth="560.0" style="-fx-border-color: #CFD6DF; -fx-border-radius: 6; -fx-background-radius: 6; -fx-background-color: white;">
         <children>
            <Label layoutX="12.0" layoutY="8.0" style="-fx-text-fill: #1E3A5F; -fx-font-weight: bold;" text="Crear servicio" />
            <Label layoutX="12.0" layoutY="34.0" style="-fx-text-fill: #5B6775;" text="Tipo" />
            <ComboBox fx:id="cmbTipo" layoutX="12.0" layoutY="54.0" prefWidth="200.0" promptText="Selecciona un tipo" />
            <Label layoutX="232.0" layoutY="34.0" style="-fx-text-fill: #5B6775;" text="Código" />
            <TextField fx:id="txtCodigo" layoutX="232.0" layoutY="54.0" prefWidth="150.0" />
            <Label layoutX="12.0" layoutY="92.0" style="-fx-text-fill: #5B6775;" text="Nombre" />
            <TextField fx:id="txtNombre" layoutX="12.0" layoutY="112.0" prefWidth="200.0" />
            <Label layoutX="232.0" layoutY="92.0" style="-fx-text-fill: #5B6775;" text="Descripción" />
            <TextField fx:id="txtDescripcion" layoutX="232.0" layoutY="112.0" prefWidth="316.0" />
            <Button fx:id="btnCrearServicio" layoutX="12.0" layoutY="154.0" mnemonicParsing="false" onAction="#onCrearServicioClick" style="-fx-background-color: #1E6FD9; -fx-text-fill: white; -fx-background-radius: 4;" text="Crear servicio" />
         </children>
      </AnchorPane>
      <AnchorPane layoutX="610.0" layoutY="88.0" prefHeight="150.0" prefWidth="376.0" style="-fx-border-color: #CFD6DF; -fx-border-radius: 6; -fx-background-radius: 6; -fx-background-color: white;">
         <children>
            <Label layoutX="12.0" layoutY="8.0" style="-fx-text-fill: #1E3A5F; -fx-font-weight: bold;" text="Personalizar servicio seleccionado" />
            <Label fx:id="lblServicioSeleccionado" layoutX="12.0" layoutY="32.0" style="-fx-text-fill: #5B6775;" text="Selecciona un servicio de la tabla" />
            <CheckBox fx:id="chkPrioritaria" layoutX="12.0" layoutY="58.0" mnemonicParsing="false" onAction="#onCaracteristicaClick" text="Atención prioritaria  +$35.000" />
            <CheckBox fx:id="chkSoporte" layoutX="12.0" layoutY="84.0" mnemonicParsing="false" onAction="#onCaracteristicaClick" text="Soporte técnico 30 días  +$50.000" />
            <CheckBox fx:id="chkDomicilio" layoutX="12.0" layoutY="110.0" mnemonicParsing="false" onAction="#onCaracteristicaClick" text="Atención a domicilio  +$25.000" />
         </children>
      </AnchorPane>
      <AnchorPane layoutX="610.0" layoutY="250.0" prefHeight="185.0" prefWidth="376.0" style="-fx-border-color: #CFD6DF; -fx-border-radius: 6; -fx-background-radius: 6; -fx-background-color: white;">
         <children>
            <Label layoutX="12.0" layoutY="14.0" text="Costo base" />
            <Label fx:id="lblCostoBase" alignment="CENTER_RIGHT" layoutX="250.0" layoutY="14.0" prefWidth="114.0" text="0" />
            <Label layoutX="12.0" layoutY="44.0" text="Incrementos" />
            <Label fx:id="lblIncrementos" alignment="CENTER_RIGHT" layoutX="250.0" layoutY="44.0" prefWidth="114.0" text="+0" />
            <Label layoutX="12.0" layoutY="74.0" style="-fx-font-weight: bold;" text="Costo final" />
            <Label fx:id="lblCostoFinal" alignment="CENTER_RIGHT" layoutX="250.0" layoutY="72.0" prefWidth="114.0" style="-fx-text-fill: #0F766E; -fx-font-size: 15px; -fx-font-weight: bold;" text="0" />
            <Label layoutX="12.0" layoutY="108.0" style="-fx-text-fill: #5B6775;" text="El servicio original del catálogo no cambia." />
            <Button fx:id="btnGuardarPersonalizado" layoutX="12.0" layoutY="138.0" mnemonicParsing="false" onAction="#onGuardarPersonalizadoClick" style="-fx-background-color: #0F766E; -fx-text-fill: white; -fx-background-radius: 4;" text="Guardar servicio personalizado" />
         </children>
      </AnchorPane>
      <Label fx:id="lblMensaje" layoutX="610.0" layoutY="447.0" prefWidth="376.0" visible="false" wrapText="true" />
   </children>
</AnchorPane>
