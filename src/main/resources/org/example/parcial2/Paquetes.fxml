            <Label layoutX="16.0" layoutY="10.0" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" text="TechSolutions" />
         </children>
      </AnchorPane>
      <AnchorPane layoutX="0.0" layoutY="38.0" prefHeight="38.0" prefWidth="1000.0" style="-fx-background-color: #DDE3EA;">
         <children>
            <Button fx:id="btnVolverInicio" layoutX="14.0" layoutY="6.0" mnemonicParsing="false" onAction="#onVolverClick" style="-fx-background-color: #44505E; -fx-text-fill: white; -fx-background-radius: 4;" text="&lt;- Inicio" />
            <Label layoutX="110.0" layoutY="9.0" style="-fx-text-fill: #1E3A5F; -fx-font-size: 15px; -fx-font-weight: bold;" text="Paquetes" />
         </children>
      </AnchorPane>
      <AnchorPane layoutX="14.0" layoutY="88.0" prefHeight="185.0" prefWidth="280.0" style="-fx-border-color: #CFD6DF; -fx-border-radius: 6; -fx-background-radius: 6; -fx-background-color: white;">
