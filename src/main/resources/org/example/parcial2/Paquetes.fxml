      <Label layoutX="310.0" layoutY="88.0" style="-fx-text-fill: #1E3A5F; -fx-font-weight: bold;" text="Disponibles para agregar" />
      <ListView fx:id="lstDisponibles" layoutX="310.0" layoutY="108.0" prefHeight="380.0" prefWidth="330.0" />
