<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="panelPaquetes" prefHeight="580.0" prefWidth="1000.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.parcial2.controller.PaquetesController">
