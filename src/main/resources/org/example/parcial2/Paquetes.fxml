         <TextField fx:id="txtCodigoPaquete" layoutX="12.0" layoutY="54.0" prefWidth="256.0" />
         <Label layoutX="12.0" layoutY="82.0" style="-fx-text-fill: #5B6775;" text="Nombre" />
         <TextField fx:id="txtNombrePaquete" layoutX="12.0" layoutY="102.0" prefWidth="256.0" />
         <Button fx:id="btnCrearPaquete" layoutX="12.0" layoutY="144.0" mnemonicParsing="false" onAction="#onCrearPaqueteClick" style="-fx-background-color: #1E6FD9; -fx-text-fill: white; -fx-background-radius: 4;" text="Crear paquete" />
