<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="panelSolicitudes" prefHeight="580.0" prefWidth="1000.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.parcial2.controller.SolicitudesController">
   <children>
      <AnchorPane layoutX="0.0" layoutY="0.0" prefHeight="38.0" prefWidth="1000.0" style="-fx-background-color: #1E3A5F;">
         <children>
            <Label layoutX="16.0" layoutY="10.0" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" text="TechSolutions" />
         </children>
      </AnchorPane>
      <AnchorPane layoutX="0.0" layoutY="38.0" prefHeight="38.0" prefWidth="1000.0" style="-fx-background-color: #DDE3EA;">
         <children>
            <Button fx:id="btnVolverInicio" layoutX="14.0" layoutY="6.0" mnemonicParsing="false" onAction="#onVolverClick" style="-fx-background-color: #44505E; -fx-text-fill: white; -fx-background-radius: 4;" text="&lt;- Inicio" />
            <Label layoutX="110.0" layoutY="9.0" style="-fx-text-fill: #1E3A5F; -fx-font-size: 15px; -fx-font-weight: bold;" text="Solicitudes" />
         </children>
      </AnchorPane>
      <AnchorPane layoutX="14.0" layoutY="88.0" prefHeight="447.0" prefWidth="440.0" style="-fx-border-color: #CFD6DF; -fx-border-radius: 6; -fx-background-radius: 6; -fx-background-color: white;">
         <children>
         <Label layoutX="12.0" layoutY="8.0" style="-fx-text-fill: #1E3A5F; -fx-font-weight: bold;" text="Datos de la solicitud" />
         <Label layoutX="12.0" layoutY="34.0" style="-fx-text-fill: #5B6775;" text="Cliente" />
         <ComboBox fx:id="cmbCliente" layoutX="12.0" layoutY="54.0" prefWidth="416.0" promptText="Selecciona un cliente" />
         <Label layoutX="12.0" layoutY="92.0" style="-fx-text-fill: #5B6775;" text="Código (obligatorio)" />
         <TextField fx:id="txtCodigoSolicitud" layoutX="12.0" layoutY="112.0" prefWidth="200.0" />
         <Label layoutX="232.0" layoutY="92.0" style="-fx-text-fill: #5B6775;" text="Prioridad (opcional)" />
         <ComboBox fx:id="cmbPrioridad" layoutX="232.0" layoutY="112.0" prefWidth="196.0" />
         <Label layoutX="12.0" layoutY="150.0" style="-fx-text-fill: #5B6775;" text="Fecha programada (opcional)" />
         <DatePicker fx:id="dpFecha" layoutX="12.0" layoutY="170.0" prefWidth="200.0" />
         <Label layoutX="12.0" layoutY="208.0" style="-fx-text-fill: #5B6775;" text="Observaciones (opcional)" />
         <TextArea fx:id="txtObservaciones" layoutX="12.0" layoutY="228.0" prefHeight="80.0" prefWidth="416.0" wrapText="true" />
         <CheckBox fx:id="chkPresencial" layoutX="12.0" layoutY="325.0" mnemonicParsing="false" onAction="#onPresencialClick" text="Requiere atención presencial" />
         <Label layoutX="12.0" layoutY="352.0" style="-fx-text-fill: #5B6775;" text="Especialidad del técnico" />
         <ComboBox fx:id="cmbEspecialidad" layoutX="12.0" layoutY="372.0" prefWidth="250.0" />
         <Button fx:id="btnRegistrar" layoutX="12.0" layoutY="410.0" mnemonicParsing="false" onAction="#onRegistrarClick" style="-fx-background-color: #0F766E; -fx-text-fill: white; -fx-background-radius: 4;" text="Registrar solicitud" />
         </children>
      </AnchorPane>
      <Label layoutX="470.0" layoutY="88.0" style="-fx-text-fill: #1E3A5F; -fx-font-weight: bold;" text="Elementos contratados" />
      <ComboBox fx:id="cmbElemento" layoutX="470.0" layoutY="108.0" prefWidth="400.0" promptText="Servicio, personalizado o paquete" />
      <Button fx:id="btnAgregarElemento" layoutX="880.0" layoutY="108.0" mnemonicParsing="false" onAction="#onAgregarElementoClick" prefWidth="106.0" style="-fx-background-color: #1E6FD9; -fx-text-fill: white; -fx-background-radius: 4;" text="Agregar" />
      <TableView fx:id="tblElementos" layoutX="470.0" layoutY="142.0" prefHeight="130.0" prefWidth="516.0">
        <columns>
          <TableColumn fx:id="colElemento" prefWidth="380.0" text="Elemento" />
          <TableColumn fx:id="colCostoElemento" prefWidth="136.0" text="Costo" />
        </columns>
      </TableView>
      <Button fx:id="btnQuitarElemento" layoutX="470.0" layoutY="280.0" mnemonicParsing="false" onAction="#onQuitarElementoClick" style="-fx-background-color: #8A94A2; -fx-text-fill: white; -fx-background-radius: 4;" text="Quitar" />
      <Label layoutX="740.0" layoutY="284.0" style="-fx-text-fill: #5B6775;" text="Total elementos" />
      <Label fx:id="lblTotalElementos" alignment="CENTER_RIGHT" layoutX="840.0" layoutY="282.0" prefWidth="146.0" style="-fx-text-fill: #0F766E; -fx-font-size: 15px; -fx-font-weight: bold;" text="0" />
      <Label layoutX="470.0" layoutY="322.0" style="-fx-text-fill: #1E3A5F; -fx-font-weight: bold;" text="Solicitudes registradas" />
      <TableView fx:id="tblSolicitudes" layoutX="470.0" layoutY="342.0" prefHeight="193.0" prefWidth="516.0">
        <columns>
          <TableColumn fx:id="colSolCodigo" prefWidth="90.0" text="Código" />
          <TableColumn fx:id="colSolCliente" prefWidth="170.0" text="Cliente" />
          <TableColumn fx:id="colSolFecha" prefWidth="110.0" text="Creada" />
          <TableColumn fx:id="colSolTotal" prefWidth="146.0" text="Total" />
        </columns>
      </TableView>
      <Label fx:id="lblMensaje" layoutX="14.0" layoutY="543.0" prefWidth="440.0" text="" visible="false" wrapText="true" />
   </children>
</AnchorPane>
